---
import { ANALYTICS, NAV_ITEMS, SITE } from "../config/site";
import globalStylesheetHref from "../styles/global.css?url";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath,
  ogImage = SITE.defaultOgImage,
  ogType = "website",
  noindex = false,
  structuredData,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, SITE.siteUrl).toString();
const robotsValue = noindex ? "noindex, nofollow" : "index, follow";
const gaMeasurementId = ANALYTICS.gaMeasurementId;
const schemaBlocks = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsValue} />

    <style>
      :root{--bg:#060a13;--bg-soft:#0b1322;--ink:#e6f0ff;--brand:#38f7bf;--brand-strong:#18d6a0;--radius-lg:8px;--content-width:1180px;--easing:cubic-bezier(.2,.9,.25,1)}
      *{box-sizing:border-box}html,body{margin:0;padding:0}
      body{min-height:100vh;color:var(--ink);background:linear-gradient(90deg,rgb(90 122 178 / 9%) 1px,transparent 1px) 0 0/42px 42px,linear-gradient(rgb(90 122 178 / 7%) 1px,transparent 1px) 0 0/42px 42px,repeating-linear-gradient(90deg,rgb(255 255 255 / 0%) 0,rgb(255 255 255 / 0%) 119px,rgb(125 151 201 / 4%) 120px),linear-gradient(180deg,var(--bg) 0%,var(--bg-soft) 100%);font-family:"Space Grotesk","Segoe UI",sans-serif;line-height:1.68;text-rendering:optimizeLegibility}
      a{color:inherit;text-decoration:none}img{max-width:100%;display:block}p,h1,h2,h3{margin:0}
      h1{font-family:"Sora","Space Grotesk",sans-serif;letter-spacing:-.024em;line-height:1.08;font-size:clamp(2.2rem,4.5vw,3.7rem)}
      .site-shell{width:min(100% - 2.4rem,var(--content-width));margin-inline:auto}
      .site-header{position:sticky;top:0;z-index:40;border-bottom:1px solid rgb(53 79 128 / 82%);background:rgb(6 11 20 / 92%);backdrop-filter:blur(8px)}
      .site-header-inner{width:min(100% - 2.4rem,var(--content-width));margin-inline:auto;min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:1rem}
      .brand{display:inline-flex;align-items:center;gap:.7rem;font-family:"Sora","Space Grotesk",sans-serif;font-size:.98rem;font-weight:700;letter-spacing:.01em}
      .brand-logo{width:28px;height:28px;object-fit:contain;display:block}
      .header-actions{display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;gap:.84rem}
      .nav-list{margin:0;padding:0;list-style:none;display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;gap:.45rem}
      .drawer-backdrop{position:fixed;inset:0;z-index:49;opacity:0;pointer-events:none}
      .drawer{position:fixed;top:0;right:0;bottom:0;z-index:50;width:min(300px,86vw);display:flex;flex-direction:column;transform:translateX(100%);visibility:hidden;pointer-events:none}
      .drawer.is-open{transform:translateX(0);visibility:visible;pointer-events:auto}
      .hamburger{display:none;align-items:center;justify-content:center;width:38px;height:38px}
      .page{display:block;padding:2.4rem 0 4rem;position:relative;z-index:1}
      .page-hero{position:relative;overflow:hidden;border:1px solid rgb(41 64 112 / 72%);border-radius:var(--radius-lg);background:radial-gradient(circle at 88% 10%,rgb(96 169 255 / 18%),transparent 36%),linear-gradient(155deg,rgb(15 25 45 / 96%) 0%,rgb(11 20 38 / 96%) 100%);padding:clamp(1.2rem,2.8vw,2.2rem)}
      .home-hero{border:1px solid rgb(66 96 156 / 86%);border-radius:var(--radius-lg);background:radial-gradient(circle at 82% 14%,rgb(96 169 255 / 14%),transparent 34%),linear-gradient(145deg,rgb(11 19 35 / 98%) 0%,rgb(9 15 28 / 98%) 100%)}
      .hero-main{display:grid;gap:1.1rem;max-width:62ch}.hero-title{max-width:20ch;font-size:clamp(2rem,3.6vw,3.1rem);line-height:1.1}.hero-lead{max-width:58ch;color:#a9bbe0;font-size:clamp(.96rem,1.1vw,1.08rem);line-height:1.76}
      .cta-row{display:flex;flex-wrap:wrap;gap:.72rem;margin-top:1.14rem}
      .btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.58rem .96rem;border:1px solid transparent;border-radius:4px;font-family:"JetBrains Mono","Cascadia Mono",monospace;font-size:.75rem;font-weight:500;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:transform .2s var(--easing),background-color .2s var(--easing)}
      .btn-primary{color:#031321;border-color:rgb(56 247 191 / 66%);background:var(--brand)}.btn-primary:hover,.btn-primary:focus-visible{background:var(--brand);border-color:rgb(56 247 191 / 66%)}
      .btn-secondary{color:#cfe0ff;border-color:rgb(41 64 112 / 88%);background:rgb(13 23 42 / 84%)}
      .detail-wrap{display:grid;gap:1.2rem;grid-template-columns:minmax(0,1fr)}.detail-side{display:grid;gap:.78rem}.case-sidebar{align-content:start}
      @media (min-width:940px){.detail-wrap{grid-template-columns:1.2fr 1fr}.case-sidebar{position:sticky;top:104px}}
      @media (max-width:860px){.site-header-inner{min-height:64px}.header-actions{gap:.6rem}.hamburger{display:flex}}
      @media (max-width:860px){.nav-list,.btn-nav{display:none}}
    </style>

    <link rel="preload" as="style" href={globalStylesheetHref} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={globalStylesheetHref} /></noscript>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&family=Sora:wght@500;600;700&display=optional"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&family=Sora:wght@500;600;700&display=optional"
      />
    </noscript>

    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, SITE.siteUrl).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.siteUrl).toString()} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />

    <title>{title}</title>

    {
      gaMeasurementId && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
          ></script>
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', '${gaMeasurementId}');`}
          ></script>
        </>
      )
    }

    {
      schemaBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body>
    <div class="bg-blobs" aria-hidden="true">
      <div class="bg-blob bg-blob-1"></div>
      <div class="bg-blob bg-blob-2"></div>
      <div class="bg-blob bg-blob-3"></div>
    </div>
    <p id="form-status" class="form-note" aria-live="polite"></p>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/" aria-label="David Vidovic home">
          <img class="brand-logo" src="/assets/img/logo/logo-light.webp" alt="David Vidovic logo" width="28" height="28" />
          <span>David Vidovic</span>
        </a>
        <div class="header-actions">
          <nav aria-label="Primary navigation">
            <ul class="nav-list">
              {
                NAV_ITEMS.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a class="btn btn-primary btn-nav" href="/#contact">Start building</a>
          <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
              <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile drawer -->
    <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
    <nav class="drawer" id="nav-drawer" aria-label="Mobile navigation" aria-hidden="true" inert>
      <div class="drawer-head">
        <a class="brand" href="/" aria-label="David Vidovic home">
          <img class="brand-logo" src="/assets/img/logo/logo-light.webp" alt="David Vidovic logo" width="28" height="28" />
          <span>David Vidovic</span>
        </a>
        <button class="drawer-close" id="drawer-close" aria-label="Close menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <ul class="drawer-nav">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li class="drawer-socials-item">
          <div class="drawer-socials" aria-label="Social links">
            <a href="https://www.linkedin.com/in/david-vidovic/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://www.upwork.com/freelancers/~0163d597d928e1e526" target="_blank" rel="noopener noreferrer" aria-label="Upwork" class="social-icon-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
            </a>
            <a href="https://github.com/davidvidovic-web" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-icon-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
            <a href="mailto:mail@davidvidovic.com" aria-label="Email" class="social-icon-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
            </a>
          </div>
        </li>
      </ul>
      <div class="drawer-footer">
        <a class="btn btn-primary" href="/#contact" style="width:100%;justify-content:center;">Start building</a>
      </div>
    </nav>

    <main class="page">
      <div class="site-shell">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="site-shell">
        <p class="footer-copy">{new Date().getFullYear()} David Vidovic. Building for clarity, speed and measurable outcomes.</p>
      </div>
    </footer>

    <script>
      const hamburger = document.getElementById("hamburger");
      const drawer = document.getElementById("nav-drawer");
      const backdrop = document.getElementById("drawer-backdrop");
      const closeBtn = document.getElementById("drawer-close");

      function openDrawer() {
        drawer?.classList.add("is-open");
        backdrop?.classList.add("is-open");
        hamburger?.setAttribute("aria-expanded", "true");
        drawer?.setAttribute("aria-hidden", "false");
        drawer?.removeAttribute("inert");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        drawer?.classList.remove("is-open");
        backdrop?.classList.remove("is-open");
        hamburger?.setAttribute("aria-expanded", "false");
        drawer?.setAttribute("aria-hidden", "true");
        drawer?.setAttribute("inert", "");
        document.body.style.overflow = "";
      }

      hamburger?.addEventListener("click", openDrawer);
      closeBtn?.addEventListener("click", closeDrawer);
      backdrop?.addEventListener("click", closeDrawer);

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeDrawer();
      });

      drawer?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeDrawer);
      });

      // Hover text roll on link-buttons and nav links
      document.querySelectorAll<HTMLElement>(".btn, .nav-list a").forEach(function(el) {
        if (el.querySelector("svg, img")) return;
        var existing = el.querySelector(":scope > .hov");
        if (existing) {
          var existingText = existing.textContent?.trim();
          if (existingText) el.dataset.hover = existingText;
          return;
        }

        // Only auto-wrap plain-text buttons/links to avoid corrupting complex markup.
        if (el.children.length > 0) return;

        var text = el.textContent?.trim();
        if (!text) return;
        el.dataset.hover = text;
        el.innerHTML = "<span class='hov'>" + text + "</span>";
      });
    </script>
  </body>
</html>
