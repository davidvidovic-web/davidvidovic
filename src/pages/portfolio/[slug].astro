---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

interface Props {
  project: CollectionEntry<"projects">;
  nextProject: CollectionEntry<"projects">;
}

export const prerender = true;

export async function getStaticPaths() {
  const featuredProjectSlugs = new Set([
    "geeks-on-site",
    "kozmeticki-salon-cats",
    "ambientivo",
    "desserts-with-ana",
  ]);

  const projects = (await getCollection("projects")).filter((project) =>
    featuredProjectSlugs.has(project.data.slug),
  );

  const ordered = projects.sort(
    (a, b) => Number.parseInt(b.data.year, 10) - Number.parseInt(a.data.year, 10),
  );

  return ordered.map((project, index) => ({
    params: { slug: project.data.slug },
    props: { project, nextProject: ordered[(index + 1) % ordered.length] },
  }));
}

const { project, nextProject } = Astro.props;
const { Content, headings } = await render(project);
const sections = headings.filter((heading) => heading.depth === 2);
const liveHost = new URL(project.data.websiteUrl).hostname.replace(/^www\./, "");
const canonicalPath = `/portfolio/${project.data.slug}`;

const LOGO_SOURCES: Record<string, { src: string; srcSet: string; width: number; height: number }> = {
  "/assets/img/brand/dessertswithana-logo.png": {
    src: "/assets/img/brand/dessertswithana-logo-200w.png",
    srcSet:
      "/assets/img/brand/dessertswithana-logo-200w.png 200w, /assets/img/brand/dessertswithana-logo-400w.png 400w",
    width: 200,
    height: 200,
  },
  "/assets/img/brand/cats-logo.avif": {
    src: "/assets/img/brand/cats-logo-200w.avif",
    srcSet: "/assets/img/brand/cats-logo-200w.avif 200w, /assets/img/brand/cats-logo-400w.avif 400w",
    width: 200,
    height: 93,
  },
  "/assets/img/brand/ambientivo-logo.png": {
    src: "/assets/img/brand/ambientivo-logo-200w.png",
    srcSet:
      "/assets/img/brand/ambientivo-logo-200w.png 200w, /assets/img/brand/ambientivo-logo-400w.png 400w",
    width: 200,
    height: 29,
  },
  "/assets/img/brand/gos-logo.webp": {
    src: "/assets/img/brand/gos-logo-200w.webp",
    srcSet: "/assets/img/brand/gos-logo-200w.webp 200w, /assets/img/brand/gos-logo-400w.webp 400w",
    width: 200,
    height: 82,
  },
};

const logoSource = LOGO_SOURCES[project.data.logo] ?? null;
const nextLogoSource = LOGO_SOURCES[nextProject.data.logo] ?? null;
const hasImpact = project.data.counters.length > 0;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.overview,
  image: new URL(project.data.detailsImage, SITE.siteUrl).toString(),
  creator: { "@id": `${SITE.siteUrl}/#person` },
  keywords: project.data.services.join(", "),
  datePublished: `${project.data.year}-01-01`,
  url: `${SITE.siteUrl}${canonicalPath}`,
};
---

<BaseLayout
  title={`${project.data.title} Case Study | David Vidovic`}
  description={project.data.overview}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImage={project.data.detailsImage}
  structuredData={structuredData}
>
  <div class="home case">
    <section class="case-top">
      <a class="case-back" href="/#work">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All work
      </a>
      <div class="case-top-grid">
        <div class="case-top-copy">
          <span class="kicker">Case study / {project.data.year}</span>
          <h1 class="case-title">{project.data.title}</h1>
          <p class="case-lead">{project.data.summary ?? project.data.overview}</p>
          <div class="cta-row">
            <a class="btn btn-primary" href={project.data.websiteUrl} rel="noopener noreferrer" target="_blank">
              Visit live site
            </a>
          </div>
        </div>
        <div class="case-visual" style={`background-color: ${project.data.backgroundColor};`}>
          <img
            src={logoSource?.src ?? project.data.logo}
            srcset={logoSource?.srcSet}
            sizes="(max-width: 980px) 60vw, 300px"
            width={logoSource?.width}
            height={logoSource?.height}
            alt={`${project.data.title} logo`}
            decoding="async"
          />
        </div>
      </div>

      <dl class="case-facts">
        <div>
          <dt>Client</dt>
          <dd>{project.data.client}</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{project.data.role}</dd>
        </div>
        <div>
          <dt>Year</dt>
          <dd>{project.data.year}</dd>
        </div>
        <div>
          <dt>Live</dt>
          <dd>
            <a href={project.data.websiteUrl} rel="noopener noreferrer" target="_blank">{liveHost}</a>
          </dd>
        </div>
      </dl>
    </section>

    {hasImpact && (
      <section class="home-section reveal reveal-2">
        <div class="home-head">
          <span class="section-index">01</span>
          <h2>Impact</h2>
        </div>
        <div class="home-content">
          <div class="case-metrics">
            {project.data.counters.map((metric) => (
              <div class="case-metric" data-reveal>
                <div class="case-metric-value">{`${metric.prefix ?? ""}${metric.value}${metric.suffix ?? ""}`}</div>
                <p class="case-metric-label">{metric.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="home-section reveal reveal-2">
      <div class="home-head case-side">
        <span class="section-index">{hasImpact ? "02" : "01"}</span>
        <h2>The project</h2>
        {sections.length > 0 && (
          <nav class="case-toc" aria-label="On this page">
            {sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
          </nav>
        )}
        <div class="case-side-group">
          <p class="work-type">Scope</p>
          <div class="card-tags">
            {project.data.services.map((service) => <span class="tag">{service}</span>)}
          </div>
        </div>
        {project.data.technologies.length > 0 && (
          <div class="case-side-group">
            <p class="work-type">Stack</p>
            <div class="card-tags">
              {project.data.technologies.map((tech) => <span class="tag">{tech}</span>)}
            </div>
          </div>
        )}
      </div>
      <article class="home-content case-prose">
        <Content />
      </article>
    </section>

    {nextProject.data.slug !== project.data.slug && (
      <nav class="case-next-wrap" aria-label="Next case study" data-reveal>
        <a class="case-study-card is-featured case-next" href={`/portfolio/${nextProject.data.slug}`} data-spot>
          <div class="case-study-body">
            <div class="work-card-top">
              <span class="work-type">Next project</span>
              <span class="case-study-year">{nextProject.data.year}</span>
            </div>
            <h3>{nextProject.data.title}</h3>
            <p>{nextProject.data.summary ?? nextProject.data.overview}</p>
            <span class="case-study-cta">
              Read case study
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                <path d="M2 11L11 2M11 2H5M11 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
          <div class="case-study-visual" style={`background-color: ${nextProject.data.backgroundColor};`}>
            <img
              src={nextLogoSource?.src ?? nextProject.data.logo}
              srcset={nextLogoSource?.srcSet}
              sizes="(max-width: 860px) 60vw, 220px"
              width={nextLogoSource?.width}
              height={nextLogoSource?.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
      </nav>
    )}
  </div>
</BaseLayout>
