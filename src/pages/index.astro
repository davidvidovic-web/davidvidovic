---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqs } from "../data/faqs";
import { otherProjects } from "../data/otherProjects";
import { services } from "../data/services";
import { testimonials } from "../data/testimonials";
import { NAV_ITEMS, SITE } from "../config/site";

const projects = (await getCollection("projects")).sort((a, b) => {
	return Number.parseInt(b.data.year, 10) - Number.parseInt(a.data.year, 10);
});

const featuredProjectSlugs = new Set([
	"geeks-on-site",
	"kozmeticki-salon-cats",
	"ambientivo",
	"desserts-with-ana",
]);

const LOGO_SOURCES: Record<string, { src: string; srcSet: string; width: number; height: number }> = {
	"/assets/img/brand/dessertswithana-logo.png": {
		src: "/assets/img/brand/dessertswithana-logo-200w.png",
		srcSet:
			"/assets/img/brand/dessertswithana-logo-200w.png 200w, /assets/img/brand/dessertswithana-logo-400w.png 400w",
		width: 200,
		height: 200,
	},
	"/assets/img/brand/cats-logo.avif": {
		src: "/assets/img/brand/cats-logo-200w.avif",
		srcSet: "/assets/img/brand/cats-logo-200w.avif 200w, /assets/img/brand/cats-logo-400w.avif 400w",
		width: 200,
		height: 93,
	},
	"/assets/img/brand/ambientivo-logo.png": {
		src: "/assets/img/brand/ambientivo-logo-200w.png",
		srcSet:
			"/assets/img/brand/ambientivo-logo-200w.png 200w, /assets/img/brand/ambientivo-logo-400w.png 400w",
		width: 200,
		height: 29,
	},
	"/assets/img/brand/gos-logo.webp": {
		src: "/assets/img/brand/gos-logo-200w.webp",
		srcSet: "/assets/img/brand/gos-logo-200w.webp 200w, /assets/img/brand/gos-logo-400w.webp 400w",
		width: 200,
		height: 82,
	},
};

function getLogoSource(logoPath: string) {
	return LOGO_SOURCES[logoPath] ?? null;
}

const featuredProjects = projects.filter((project) => featuredProjectSlugs.has(project.data.slug));

const experience = [
	{
		period: "2023 – now",
		role: "Full-stack software engineer, freelance",
		company: "Upwork",
		link: "https://www.upwork.com/freelancers/~0163d597d928e1e526",
		note: "Top Rated with a 100% Job Success Score across 22+ international clients. Full-stack web apps, custom APIs and client dashboards.",
	},
	{
		period: "2024 – 2025",
		role: "Software engineer",
		company: "Converted UK",
		link: "https://converted.co.uk",
		note: "Built accessible website components in an agile team and fixed performance issues on client sites.",
	},
	{
		period: "2022 – 2024",
		role: "Backend developer",
		company: "Effecticore DE",
		link: "https://effecticore.com",
		note: "Built a server-side API for automated PDF reports, rebuilt slow legacy sites as lightweight custom themes and set up deployment pipelines.",
	},
	{
		period: "2020 – 2022",
		role: "Frontend and systems developer",
		company: "Obsidian Media DK",
		link: "https://obsidianmedia.dk",
		note: "Kept a network of 80+ commercial websites fast, secure and reliable, and built internal publishing tools.",
	},
	{
		period: "2019",
		role: "Junior web developer",
		company: "Ad-kraft",
		link: "https://ad-kraft.com",
		note: "Built custom WordPress sites and blogs from design mockups.",
	},
];

const featuredTestimonials = [3, 5, 1]
	.map((id) => testimonials.find((item) => item.id === id))
	.filter((item) => item !== undefined);

const stackRows = [
	[
		"React",
		"Next.js",
		"TypeScript",
		"JavaScript",
		"Tailwind CSS",
		"Astro",
		"Vite",
		"Three.js",
		"GSAP",
		"Figma",
		"Playwright",
		"Shopify",
		"WordPress",
		"WooCommerce",
	],
	[
		"Node.js",
		"PHP",
		"Laravel",
		"PostgreSQL",
		"MySQL",
		"SQLite",
		"Supabase",
		"Redis",
		"Drizzle",
		"REST API",
		"GraphQL",
		"Docker",
		"Stripe",
		"OpenAI API",
	],
];

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "SiteNavigationElement",
		name: "Main Navigation",
		url: SITE.siteUrl,
		hasPart: NAV_ITEMS.map((item) => ({
			"@type": "WebPage",
			name: item.label,
			url: `${SITE.siteUrl}${item.href}`,
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "Person",
		"@id": `${SITE.siteUrl}/#person`,
		name: "David Vidovic",
		url: SITE.siteUrl,
		image: `${SITE.siteUrl}/assets/img/logo/logo-light.webp`,
		jobTitle: "Full-stack Web Developer",
		description: SITE.description,
		sameAs: [
			"https://www.linkedin.com/in/david-vidovic/",
			"https://github.com/davidvidovic-web",
			"https://www.upwork.com/freelancers/~0163d597d928e1e526",
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "ProfessionalService",
		name: "David Vidovic - Web Development Services",
		url: `${SITE.siteUrl}/service`,
		areaServed: "Worldwide",
		provider: {
			"@type": "Person",
			name: "David Vidovic",
			url: SITE.siteUrl,
		},
		serviceType: services.map((service) => service.title),
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faqs.map((item) => ({
			"@type": "Question",
			name: item.question,
			acceptedAnswer: {
				"@type": "Answer",
				text: item.answer,
			},
		})),
	},
];
---

<BaseLayout
	title={SITE.title}
	description={SITE.description}
	canonicalPath="/"
	structuredData={structuredData}
>
	<div class="home">
	<section class="page-hero home-hero">
		<div class="hero-main">
			<h1 class="hero-title">
				Hey, I’m David <span class="hero-wave" aria-hidden="true">👋</span>
				<span class="hero-title-soft">I build websites, web apps and the tools behind them.</span>
			</h1>
			<div class="hero-bottom">
				<p class="hero-lead">
					I’m a full-stack web developer and I’ve been at it for over eight years, building
					everything from online shops and booking systems to payment integrations and
					standalone apps.
				</p>
				<div class="cta-row">
					<a class="btn btn-primary" href="#work">See work</a>
					<a class="text-link" href="#contact">Get in touch</a>
				</div>
			</div>
		</div>
		<dl class="case-facts hero-strip">
			<div>
				<dt>Based in</dt>
				<dd>Austria</dd>
			</div>
			<div>
				<dt>Experience</dt>
				<dd>8+ years</dd>
			</div>
			<div>
				<dt>Stack</dt>
				<dd>React, Next.js, TypeScript, PHP, Laravel</dd>
			</div>
			<div>
				<dt>Elsewhere</dt>
				<dd>
					<a href="https://github.com/davidvidovic-web" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="https://www.linkedin.com/in/david-vidovic/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				</dd>
			</div>
		</dl>
		<div class="stack-rows" aria-label="Technologies I work with">
			{
				stackRows.map((row, rowIndex) => (
					<div class:list={["stack-marquee", { "is-reverse": rowIndex % 2 === 1 }]}>
						<ul class="stack-track">
							{row.map((item) => <li>{item}</li>)}
						</ul>
						<ul class="stack-track" aria-hidden="true">
							{row.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="home-section reveal reveal-2" id="work">
		<div class="home-head">
			<span class="section-index">01</span>
			<h2>Work</h2>
			<p>Client projects, plugins and tools I designed and built.</p>
		</div>
		<div class="home-content">
			<div class="grid case-study-grid">
				{
					featuredProjects.map((project, index) => {
						const logoSource = getLogoSource(project.data.logo);

						return (
							<a class:list={["case-study-card", { "is-featured": index === 0 }]} href={`/portfolio/${project.data.slug}`} data-spot data-reveal>
								<div
									class="case-study-visual"
									style={`background-color: ${project.data.backgroundColor};`}
								>
									<img
										src={logoSource?.src ?? project.data.logo}
										srcset={logoSource?.srcSet}
										sizes="(max-width: 860px) 60vw, 220px"
										width={logoSource?.width}
										height={logoSource?.height}
										alt={`${project.data.title} logo`}
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="case-study-body">
									<div class="work-card-top">
										<span class="work-type">Client site · {project.data.role}</span>
										<span class="case-study-year">{project.data.year}</span>
									</div>
									<h3>{project.data.title}</h3>
									<p>{project.data.summary ?? project.data.overview}</p>
									<div class="card-tags">
										{project.data.technologies.slice(0, 4).map((tech) => (
											<span class="tag">{tech}</span>
										))}
									</div>
									<span class="case-study-cta">
										Read case study
										<svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
											<path d="M2 11L11 2M11 2H5M11 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									</span>
								</div>
							</a>
						);
					})
				}
			</div>

			<h3 class="work-subhead">Plugins, tools and other sites</h3>
			<div class="other-projects-list">
				{
					otherProjects.map((project) => (
						<a class="other-project-row work-row" data-reveal href={project.link} rel="noopener noreferrer" target="_blank">
							<span class="work-type">{project.type}</span>
							<span class="work-row-text">
								<span class="other-project-title">{project.title}</span>
								<span class="work-row-sub">{project.subtitle}</span>
							</span>
							<svg class="other-project-arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
								<path d="M3.75 14.25L14.25 3.75M14.25 3.75H6.75M14.25 3.75V11.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="home-section reveal reveal-2" id="about">
		<div class="home-head">
			<span class="section-index">02</span>
			<h2>About</h2>
		</div>
		<div class="home-content">
			<p class="about-lead">
				I’m a full-stack web developer with a B.Sc. in Computer Science and more than eight years
				of building web apps, APIs and developer tools.
			</p>
			<p class="about-body">
				I’m comfortable across the whole stack, from frontends in React and Next.js to backend
				services in PHP, Laravel and Python. A growing part of my work is AI: retrieval pipelines,
				vector search and LLM integrations. Whatever the project, I care about fast pages, clean
				deployments and code the next person can maintain.
			</p>

			<h3 class="work-subhead">Experience</h3>
			<div class="exp-list">
				{
					experience.map((item) => (
						<div class="exp-row" data-reveal>
							<span class="work-type">{item.period}</span>
							<div class="exp-text">
								<p class="exp-role">
									{item.role} ·{" "}
									<a href={item.link} target="_blank" rel="noopener noreferrer">{item.company}</a>
								</p>
								<p class="work-row-sub">{item.note}</p>
							</div>
						</div>
					))
				}
			</div>

			<dl class="case-facts about-facts" data-reveal>
				<div>
					<dt>Education</dt>
					<dd>B.Sc. Business Informatics / Computer Science, Paneuropean University Apeiron, 2026</dd>
				</div>
				<div>
					<dt>Languages</dt>
					<dd>English (fluent), Bosnian / Croatian / Serbian (native), German (learning)</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="home-section reveal reveal-3" id="testimonials">
		<div class="home-head">
			<span class="section-index">03</span>
			<h2>What clients said</h2>
		</div>
		<div class="home-content">
			<div class="grid quote-grid">
				{
					featuredTestimonials.map((item) => (
						<article class="card quote-card" data-reveal>
							<p class="quote">{item.content}</p>
							<p class="quote-meta">{item.name}, {item.designation}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="home-section reveal reveal-3" id="faq">
		<div class="home-head">
			<span class="section-index">04</span>
			<h2>FAQ</h2>
			<p>Common questions before project kickoff and planning.</p>
		</div>
		<div class="home-content">
			<div class="grid faq-list">
				{
					faqs.map((item) => (
						<details class="card" data-reveal>
							<summary>
								<strong>{item.question}</strong>
							</summary>
							<p>{item.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="home-section reveal reveal-3" id="contact">
		<div class="home-head">
			<span class="section-index">05</span>
			<h2>Contact</h2>
			<p>Email is the quickest way to reach me. The form works too.</p>
		</div>
		<div class="home-content">
			<div class="contact-panel" data-reveal>
			<div class="contact-grid">
				<div class="surface">
					<form id="contact-form" class="mf-form contact-form" novalidate>
						<div class="contact-fields">
							<label class="contact-field">
								<span>Name</span>
								<input class="mf-input" name="name" type="text" autocomplete="name" required />
							</label>
							<label class="contact-field">
								<span>Email</span>
								<input class="mf-input" name="email" type="email" autocomplete="email" required />
							</label>
						</div>
						<label class="contact-field">
							<span>Message</span>
							<textarea class="mf-input" name="message" rows="4" required></textarea>
						</label>

						<input type="hidden" name="interested" value="General enquiry" />
						<input type="hidden" name="formStart" id="form-start" />
						<div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
							<label for="honeypot">Leave this field empty</label>
							<input id="honeypot" name="honeypot" type="text" tabindex="-1" autocomplete="off" />
						</div>

						<div>
							<button type="submit" class="btn btn-primary" id="mf-submit">Send message</button>
						</div>

						<div id="form-status" class="form-result" aria-live="polite" hidden>
							<svg class="form-result-icon" viewBox="0 0 48 48" aria-hidden="true">
								<circle class="form-result-ring" cx="24" cy="24" r="18"></circle>
								<path class="form-result-check" d="M15.5 24.5 21.5 30.5 33 18.5"></path>
								<path class="form-result-cross-a" d="M16 16L32 32"></path>
								<path class="form-result-cross-b" d="M32 16L16 32"></path>
							</svg>
							<div class="form-result-copy">
								<strong class="form-result-title"></strong>
								<p class="form-result-text"></p>
							</div>
						</div>
					</form>
				</div>
				<div class="connect-grid connect-grid--contact">
					<a href="mailto:mail@davidvidovic.com" class="connect-card">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
						<div class="connect-card-text">
							<span class="connect-card-name">Email</span>
							<span class="connect-card-sub">mail@davidvidovic.com</span>
						</div>
						<svg class="connect-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H7M13 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
					<a href="https://github.com/davidvidovic-web" target="_blank" rel="noopener noreferrer" class="connect-card">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
						<div class="connect-card-text">
							<span class="connect-card-name">GitHub</span>
							<span class="connect-card-sub">davidvidovic-web</span>
						</div>
						<svg class="connect-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H7M13 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
					<a href="https://www.linkedin.com/in/david-vidovic/" target="_blank" rel="noopener noreferrer" class="connect-card">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
						<div class="connect-card-text">
							<span class="connect-card-name">LinkedIn</span>
							<span class="connect-card-sub">david-vidovic</span>
						</div>
						<svg class="connect-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H7M13 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
					<a href="https://www.upwork.com/freelancers/~0163d597d928e1e526" target="_blank" rel="noopener noreferrer" class="connect-card">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
						<div class="connect-card-text">
							<span class="connect-card-name">Upwork</span>
							<span class="connect-card-sub">Profile and client reviews</span>
						</div>
						<svg class="connect-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H7M13 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</div>
			</div>
			</div>
		</div>
	</section>
	</div>
</BaseLayout>

<script>
// @ts-nocheck
(function () {
	const form = document.getElementById("contact-form");
	if (!form) return;
	const statusEl = document.getElementById("form-status");
	const titleEl = statusEl.querySelector(".form-result-title");
	const textEl = statusEl.querySelector(".form-result-text");
	const submitBtn = document.getElementById("mf-submit");
	const formStartEl = document.getElementById("form-start");
	if (formStartEl) formStartEl.value = String(Date.now());

	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	function showResult(state, title, message) {
		form.classList.remove("is-loading");
		form.classList.add("is-locked", state);
		statusEl.hidden = false;
		statusEl.classList.remove("is-loading", "is-success", "is-error");
		statusEl.classList.add(state);
		titleEl.textContent = title;
		textEl.textContent = message;
		requestAnimationFrame(() => statusEl.classList.add("is-visible"));
		form.querySelectorAll("input, textarea, button").forEach((el) => (el.disabled = true));
	}

	form.addEventListener("input", (e) => e.target.classList.remove("mf-invalid"));

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		const fields = {
			name: form.elements.name,
			email: form.elements.email,
			message: form.elements.message,
		};
		const invalid = [
			!fields.name.value.trim() && fields.name,
			!EMAIL_RE.test(fields.email.value.trim()) && fields.email,
			!fields.message.value.trim() && fields.message,
		].filter(Boolean);
		if (invalid.length) {
			invalid.forEach((el) => el.classList.add("mf-invalid"));
			invalid[0].focus();
			return;
		}

		form.classList.add("is-loading");
		statusEl.hidden = false;
		statusEl.classList.add("is-loading", "is-visible");
		titleEl.textContent = "Sending message";
		textEl.textContent = "One moment.";
		submitBtn.disabled = true;

		try {
			const res = await fetch("/api/contact", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
			});
			const result = await res.json();
			if (!res.ok) throw new Error(result.error || "Failed to send.");
			showResult("is-success", "Message sent", "Thanks, I’ll get back to you soon.");
		} catch (err) {
			showResult("is-error", "Message not sent", err instanceof Error ? err.message : "Failed to send message.");
		}
	});
})();
</script>
