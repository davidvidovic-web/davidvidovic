---
// @ts-nocheck
return Astro.redirect("/#contact", 301);
---

<BaseLayout
  title="Contact | David Vidovic"
  description="Start a WordPress, WooCommerce or custom web project with a clear scope, timeline and implementation plan."
  canonicalPath="/contact"
>
  <section class="page-hero reveal">
    <span class="kicker">Contact</span>
    <h1>Let’s Scope Your Next Build</h1>
    <p>
      Share your project goals and constraints. I will follow up with a practical implementation
      path and effort estimate.
    </p>
  </section>

  <section class="section surface reveal reveal-2">
    <form id="contact-form" class="form" novalidate>
      <div class="form-row">
        <div class="form-field">
          <label for="name">What is your name? *</label>
          <input id="name" name="name" type="text" placeholder="Jack Smith" required />
        </div>

        <div class="form-field">
          <label for="email">Enter your email address *</label>
          <input id="email" name="email" type="email" placeholder="jack.smith@example.com" required />
        </div>
      </div>

      <div class="form-field">
        <label for="interested">What service are you interested in? *</label>
        <select id="interested" name="interested" required>
          {serviceOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>

      <div class="form-field">
        <label for="website">Do you already have a website?</label>
        <input id="website" name="website" type="text" placeholder="mywebsite.com" />
      </div>

      <div class="form-field">
        <label for="message">How can I help you? *</label>
        <textarea id="message" name="message" placeholder="Tell me about your project goals..." required></textarea>
      </div>

      <input type="hidden" name="formStart" id="form-start" />
      <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <label for="honeypot">Leave this field empty</label>
        <input id="honeypot" name="honeypot" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="cta-row">
        <button class="btn btn-primary" type="submit" id="submit-btn">Send message</button>
      </div>

      <div id="form-status" class="form-result" aria-live="polite" hidden>
        <svg class="form-result-icon" viewBox="0 0 48 48" aria-hidden="true">
          <circle class="form-result-spinner form-result-spinner-track" cx="24" cy="24" r="18"></circle>
          <path class="form-result-spinner form-result-spinner-head" d="M42 24a18 18 0 0 0-18-18"></path>
          <circle class="form-result-ring" cx="24" cy="24" r="18"></circle>
          <path class="form-result-check" d="M15.5 24.5 21.5 30.5 33 18.5"></path>
          <path class="form-result-cross-a" d="M16 16L32 32"></path>
          <path class="form-result-cross-b" d="M32 16L16 32"></path>
        </svg>
        <div class="form-result-copy">
          <span class="form-result-state"></span>
          <strong class="form-result-title"></strong>
          <p class="form-result-text"></p>
        </div>
      </div>
    </form>
  </section>

  <script>
    // @ts-nocheck
    const form = document.getElementById("contact-form");
    const status = form ? form.querySelector("#form-status") : null;
    const statusState = status ? status.querySelector(".form-result-state") : null;
    const statusTitle = status ? status.querySelector(".form-result-title") : null;
    const statusText = status ? status.querySelector(".form-result-text") : null;
    const submitButton = document.getElementById("submit-btn");
    const formStart = document.getElementById("form-start");

    if (form && status && submitButton && formStart) {
      let formLocked = false;
      const originalLabel = submitButton.textContent || "Send message";
      const originalHoverLabel = submitButton.dataset.hover;

      function applyAnimatedLabel(button, label) {
        button.dataset.hover = label;
        const hoverText = button.querySelector(".hov");

        if (hoverText) {
          hoverText.textContent = label;
        } else {
          button.innerHTML = `<span class="hov">${label}</span>`;
        }
      }

      function lockFormResult(state, title, message) {
        formLocked = true;
        form.dataset.locked = "true";
        form.classList.add("is-locked", state);
        status.hidden = false;
        status.classList.remove("is-visible", "is-success", "is-error");
        status.classList.remove("is-loading");
        status.classList.add(state);
        if (statusState) statusState.textContent = state === "is-success" ? "Sent" : "Failed";
        if (statusTitle) statusTitle.textContent = title;
        if (statusText) statusText.textContent = message;
        requestAnimationFrame(() => status.classList.add("is-visible"));
        form.querySelectorAll("input, select, textarea, button").forEach((control) => {
          control.disabled = true;
        });
      }

      formStart.value = String(Date.now());

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (formLocked) return;
        status.classList.remove("is-error", "is-success", "is-visible");
        form.classList.add("is-loading");
        status.hidden = false;
        status.classList.add("is-loading", "is-visible");
        if (statusState) statusState.textContent = "Sending";
        if (statusTitle) statusTitle.textContent = "Sending message";
        if (statusText) statusText.textContent = "Please wait while your message is submitted.";

        const payload = Object.fromEntries(new FormData(form).entries());
        submitButton.setAttribute("disabled", "true");
        submitButton.setAttribute("aria-busy", "true");

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || "Failed to send message.");
          }

          form.classList.remove("is-loading");
          lockFormResult("is-success", "Message sent", "I’ll get back to you shortly!");
        } catch (error) {
          form.classList.remove("is-loading");
          lockFormResult(
            "is-error",
            "Message not sent",
            error instanceof Error ? error.message : "Failed to send message. Reload the page to try again.",
          );
        }
      });
    }
  </script>
</BaseLayout>
